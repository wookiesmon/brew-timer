# ---- Credentials (never commit a real .env) ----------------------------------
# Coinbase CDP API key: grant "View" + "Trade" only. NEVER "Transfer".
COINBASE_API_KEY=
# PEM private key; keep the \n escapes on one line.
COINBASE_API_SECRET=
# Hyperliquid API-wallet ("agent") private key. API wallets can trade but cannot withdraw.
HYPERLIQUID_PRIVATE_KEY=
# Your main Hyperliquid account address (the account the API wallet trades for).
HYPERLIQUID_ACCOUNT_ADDRESS=
HYPERLIQUID_TESTNET=false

# ---- Live-trading gates (all must be set deliberately) ----------------------
COINBASE_LIVE_TRADING=false
HYPERLIQUID_LIVE_TRADING=false
DRY_RUN=true

# ---- Risk limits --------------------------------------------------------------
ACCOUNT_EQUITY_USD=2000
MAX_ALLOCATION_PCT=10
MAX_PLANNED_LOSS_PCT=1
MAX_DAILY_LOSS_USD=50
MAX_POSITION_NOTIONAL_USD=200
MAX_OPEN_ORDERS=8
HYPERLIQUID_LEVERAGE=1
HYPERLIQUID_ISOLATED=true
# Must be true (and confirmed interactively) before HYPERLIQUID_LEVERAGE may exceed 1.
HYPERLIQUID_ALLOW_LEVERAGE_ABOVE_1=false
STOP_BUFFER_PCT=0.25

# ---- Cost assumptions (deliberately conservative) -----------------------------
COINBASE_FEE_PCT=1.2
HYPERLIQUID_FEE_PCT=0.05
SLIPPAGE_PCT=0.5

# ---- Runtime ------------------------------------------------------------------
CANDLE_INTERVAL=1h
POLL_SECONDS=30
ENTRY_TTL_HOURS=48
MAX_RETRIES=4
API_TIMEOUT_SECONDS=15
API_ERROR_COOLDOWN_SECONDS=120
SIM_VOLUME_PARTICIPATION_PCT=20
DATABASE_PATH=trading_bot.sqlite3
# Optional audit log (secrets are redacted). Leave empty to log to the terminal only.
LOG_FILE=bot.log
